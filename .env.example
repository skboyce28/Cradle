# Copy this file to .env and fill in your Supabase project's values.
# .env is ignored by git, so your values never get committed.
# On Netlify, set these same two names under Site configuration > Environment variables instead.

# Project URL, from the Connect button or Project Settings in Supabase
CRADLE_SUPABASE_URL=https://your-project-ref.supabase.co

# The PUBLISHABLE key (sb_publishable_...). Never the secret key (sb_secret_...).
CRADLE_SUPABASE_KEY=sb_publishable_your_key_here

# Optional: a donation link (Buy Me a Coffee, Ko-fi, PayPal.me, ...). Shows a
# "Buy me a coffee" button in the profile menu and About. Leave it out to hide it.
# CRADLE_DONATE_URL=https://buymeacoffee.com/yourname
